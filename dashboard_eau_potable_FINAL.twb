          <datasource-dependencies datasource='Parameters'>
            <column caption='Stabilité Politique (seuil -3 à 3)' datatype='real' name='[Paramètre 1]' param-domain-type='range' role='measure' type='quantitative' value='-0.89999999999999991'>
              <calculation class='tableau' formula='-0.89999999999999991' />
              <range granularity='0.1' max='3.0' min='-3.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1menff51pj1qnx16o8lmw0z352oz'>
            <column caption='Priorité intervention' datatype='string' name='[Calculation_0750208930766848]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [pct_acces_basique] &gt;= 95&#13;&#10;THEN &quot;Accès suffisant&quot;&#13;&#10;ELSEIF [pct_acces_basique] &gt;= 80&#13;&#10;THEN &quot;Besoin modéré&quot;&#13;&#10;ELSEIF [pct_acces_basique] &lt; 80 AND [stabilite_politique] &lt; [Parameters].[Paramètre 1]&#13;&#10;THEN &quot;Urgence — intervention difficile&quot;&#13;&#10;ELSEIF [pct_acces_basique] &lt; 80 AND [stabilite_politique] &gt;= [Parameters].[Paramètre 1]&#13;&#10;THEN &quot;Priorité DWFA&quot;&#13;&#10;ELSE &quot;Données manquantes&quot;&#13;&#10;END' />
            </column>
            <column caption='Stabilité politique moyenne' datatype='real' name='[Calculation_1173245617160199]' role='measure' type='quantitative'>
