        <aliases>
          <alias key='&quot;[federated.1menff51pj1qnx16o8lmw0z352oz].[avg:pct_acces_basique:qk]&quot;' value='% Acces Basique' />
          <alias key='&quot;[federated.1menff51pj1qnx16o8lmw0z352oz].[avg:pct_acces_securise:qk]&quot;' value='% Accès Sécurisé' />
          <alias key='&quot;[federated.1menff51pj1qnx16o8lmw0z352oz].[avg:pct_pop_rurale:qk]&quot;' value='% Pop Rurale' />
