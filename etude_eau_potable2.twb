      <aliases enabled='yes' />
      <column caption='% Accès safely managed' datatype='real' name='[Calculation_0677089600512001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nb_pop_total] * [pct_acces_securise]) / SUM([nb_pop_total])' />
      </column>
      <column caption='Pop sans accès basique' datatype='real' name='[Calculation_0677089600712706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nb_pop_total] * (1 - [pct_acces_basique] / 100))' />
      </column>
      <column caption='Décès WASH total' datatype='real' name='[Calculation_0677089600884739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nb_deces_wash])' />
      </column>
      <column caption='Décès WASH (négatif)' datatype='real' name='[Calculation_0677089601191940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-SUM([nb_deces_wash])' />
      </column>
      <column caption='Nombre de pays' datatype='integer' name='[Calculation_0677089601380357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([pays])' />
      </column>
      <column caption='Stabilité politique moyenne' datatype='real' name='[Calculation_0677089601773575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([stabilite_politique])' />
      </column>
      <column caption='Accès basique moyen' datatype='real' name='[Calculation_0677089601904648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([pct_acces_basique])' />
      </column>
      <column caption='Accès safely managed moyen' datatype='real' name='[Calculation_0677089601978377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([pct_acces_securise])' />
      </column>
      <column caption='Catégorie stabilité' datatype='string' name='[Calculation_0677089653452810]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [stabilite_politique] &gt;= [Parameters].[Paramètre 1]&#13;&#10;THEN &quot;Stable&quot;&#13;&#10;ELSE &quot;Instable&quot;&#13;&#10;END' />
      </column>
      <column caption='Niveau stabilité' datatype='string' name='[Calculation_0677089654345739]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [stabilite_politique] &gt;= 0.5 THEN &quot;Élevée&quot;&#13;&#10;ELSEIF [stabilite_politique] &gt;= 0 THEN &quot;Modérée&quot;&#13;&#10;ELSEIF [stabilite_politique] &gt;= -0.5 THEN &quot;Faible&quot;&#13;&#10;ELSE &quot;Critique&quot;&#13;&#10;END' />
      </column>
      <column caption='Pays sous seuil (booléen)' datatype='boolean' name='[Calculation_0677089654501388]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[stabilite_politique] &lt; [Parameters].[Paramètre 1]' />
      </column>
      <column caption='Écart basique - safely managed' datatype='real' name='[Calculation_0677089654648845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[pct_acces_basique] - [pct_acces_securise]' />
      </column>
      <column caption='Safely managed disponible' datatype='boolean' name='[Calculation_0677089654779918]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([pct_acces_securise])' />
      </column>
      <column caption='Diagnostic DWFA' datatype='string' name='[Calculation_0677089654894607]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [pct_acces_basique] &lt; 75 AND [pct_pop_rurale] &gt; 50&#13;&#10;THEN &quot;D1 — Création&quot;&#13;&#10;ELSEIF [pct_acces_basique] &gt;= 75 AND (ISNULL([pct_acces_securise]) OR [pct_acces_securise] &lt; 50)&#13;&#10;THEN &quot;D2 — Modernisation&quot;&#13;&#10;ELSEIF [stabilite_politique] &gt; [Parameters].[Paramètre 1]&#13;&#10;THEN &quot;D3 — Consulting&quot;&#13;&#10;ELSE &quot;Non classifié&quot;&#13;&#10;END' />
      </column>
      <column caption='Flag D1 — Création' datatype='boolean' name='[Calculation_0677089655074832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[pct_acces_basique] &lt; 75 AND [pct_pop_rurale] &gt; 50' />
      </column>
      <column caption='Flag D2 — Modernisation' datatype='boolean' name='[Calculation_0677089655197713]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[pct_acces_basique] &gt;= 75&#13;&#10;AND (ISNULL([pct_acces_securise]) OR [pct_acces_securise] &lt; 50)' />
      </column>
      <column caption='Flag D3 — Consulting' datatype='boolean' name='[Calculation_0677089655283730]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[stabilite_politique] &gt; [Parameters].[Paramètre 1]' />
      </column>
      <column caption='[LOD] Part rurale mondiale' datatype='real' name='[Calculation_0677089655545875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [annee] :&#13;&#10;  SUM([nb_pop_rurale]) / SUM([nb_pop_total]) * 100 }' />
      </column>
      <column caption='[LOD] Accès basique mondial pondéré' datatype='real' name='[Calculation_0677089655635988]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [annee] :&#13;&#10;  SUM([nb_pop_total] * [pct_acces_basique]) / SUM([nb_pop_total]) }' />
      </column>
      <column caption='[LOD] Population mondiale totale' datatype='integer' name='[Calculation_0677089655713813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [annee] : SUM([nb_pop_total]) }' />
      </column>
      <column caption='%accès basique' datatype='real' name='[Calculation_0677090461454358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[nb_pop_total] * (1 - [pct_acces_basique] / 100)' />
      </column>
