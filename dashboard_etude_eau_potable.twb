    <worksheet name='Diagnostic'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Book' underline='true'>DIAGNOSTIC FINAL</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dwfa_consolide' name='federated.1menff51pj1qnx16o8lmw0z352oz' />
            <datasource caption='Paramètres' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='P_Seuil_stabilite' datatype='real' name='[Paramètre 1]' param-domain-type='range' role='measure' type='quantitative' value='0.'>
              <calculation class='tableau' formula='0.' />
              <range granularity='0.1' max='3.0' min='-3.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1menff51pj1qnx16o8lmw0z352oz'>
            <column caption='Explication Diagnostic' datatype='string' name='[Calculation_0271579604361222]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([Calculation_1173245618044944]) = &quot;D1 — Création&quot;&#13;&#10;THEN &quot;Accès basique insuffisant et population majoritairement rurale — infrastructure à construire&quot;&#13;&#10;ELSEIF ATTR([Calculation_1173245618044944]) = &quot;D2 — Modernisation&quot;&#13;&#10;THEN &quot;Accès basique correct mais qualité insuffisante — réseau existant à moderniser&quot;&#13;&#10;ELSEIF ATTR([Calculation_1173245618044944]) = &quot;D3 — Consulting&quot;&#13;&#10;THEN &quot;Contexte politique stable — intervention par conseil gouvernemental possible&quot;&#13;&#10;ELSE &quot;Profil non classifié — données insuffisantes&quot;&#13;&#10;END' />
            </column>
            <column caption='Diagnostic DWFA' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1173245618044944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [pct_acces_basique] &lt; 75&#13;&#10;AND [pct_pop_rurale] &gt; 50&#13;&#10;THEN &quot;D1 — Création&quot;&#13;&#10;ELSEIF [pct_acces_basique] &gt;= 75&#13;&#10;AND (ISNULL([pct_acces_securise])&#13;&#10;OR [pct_acces_securise] &lt; 50)&#13;&#10;THEN &quot;D2 — Modernisation&quot;&#13;&#10;ELSEIF [stabilite_politique] &gt; [Parameters].[Paramètre 1]&#13;&#10;THEN &quot;D3 — Consulting&quot;&#13;&#10;ELSE &quot;Non classifié&quot;&#13;&#10;END' />
            </column>
            <column caption='Annee' datatype='integer' name='[annee]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_1173245618044944]' derivation='Attribute' name='[attr:Calculation_1173245618044944:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1173245618044944]' derivation='Min' name='[min:Calculation_1173245618044944:nk]' pivot='key' type='nominal' />
            <column-instance column='[annee]' derivation='None' name='[none:annee:qk]' pivot='key' type='quantitative' />
            <column-instance column='[pays]' derivation='None' name='[none:pays:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Pays' datatype='string' name='[pays]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Pct Acces Basique' datatype='real' name='[pct_acces_basique]' role='measure' type='quantitative' />
            <column caption='Pct Acces Securise' datatype='real' name='[pct_acces_securise]' role='measure' type='quantitative' />
            <column caption='Pct Pop Rurale' datatype='real' name='[pct_pop_rurale]' role='measure' type='quantitative' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column datatype='real' name='[stabilite_politique]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0271579604361222]' derivation='User' name='[usr:Calculation_0271579604361222:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1menff51pj1qnx16o8lmw0z352oz].[none:annee:qk]' included-values='in-range'>
            <min>2017</min>
            <max>2017</max>
