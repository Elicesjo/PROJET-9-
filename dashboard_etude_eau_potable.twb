      <aliases enabled='yes' />
      <column caption='Couleur Stabilité' datatype='string' name='[Calculation_0271579519709187]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([stabilite_politique]) &lt; 0 THEN &quot;Instable&quot; ELSE &quot;Stable&quot; END' />
      </column>
      <column caption='part urbaine' datatype='real' name='[Calculation_0271579556798468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nb_pop_urbaine]) / SUM([nb_pop_total])*100' />
      </column>
      <column caption='Couleur Diagnostic' datatype='integer' name='[Calculation_0271579604180997]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Calculation_1173245618044944]) = &quot;D1 — Création&quot; THEN 1&#13;&#10;ELSEIF ATTR([Calculation_1173245618044944]) = &quot;D2 — Modernisation&quot; THEN 2&#13;&#10;ELSEIF ATTR([Calculation_1173245618044944]) = &quot;D3 — Consulting&quot; THEN 3&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Explication Diagnostic' datatype='string' name='[Calculation_0271579604361222]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ATTR([Calculation_1173245618044944]) = &quot;D1 — Création&quot;&#13;&#10;THEN &quot;Accès basique insuffisant et population majoritairement rurale — infrastructure à construire&quot;&#13;&#10;ELSEIF ATTR([Calculation_1173245618044944]) = &quot;D2 — Modernisation&quot;&#13;&#10;THEN &quot;Accès basique correct mais qualité insuffisante — réseau existant à moderniser&quot;&#13;&#10;ELSEIF ATTR([Calculation_1173245618044944]) = &quot;D3 — Consulting&quot;&#13;&#10;THEN &quot;Contexte politique stable — intervention par conseil gouvernemental possible&quot;&#13;&#10;ELSE &quot;Profil non classifié — données insuffisantes&quot;&#13;&#10;END' />
      </column>
      <column caption='Filtre pays' datatype='boolean' name='[Calculation_0271647962566657]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[pays] = [Parameters].[Paramètre 3]' />
      </column>
      <column caption='Priorité intervention' datatype='string' name='[Calculation_0750208930766848]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [pct_acces_basique] &gt;= 95&#13;&#10;THEN &quot;Accès suffisant&quot;&#13;&#10;ELSEIF [pct_acces_basique] &gt;= 80&#13;&#10;THEN &quot;Besoin modéré&quot;&#13;&#10;ELSEIF [pct_acces_basique] &lt; 80 AND [stabilite_politique] &lt; [Parameters].[Paramètre 1]&#13;&#10;THEN &quot;Urgence — intervention difficile&quot;&#13;&#10;ELSEIF [pct_acces_basique] &lt; 80 AND [stabilite_politique] &gt;= [Parameters].[Paramètre 1]&#13;&#10;THEN &quot;Priorité DWFA&quot;&#13;&#10;ELSE &quot;Données manquantes&quot;&#13;&#10;END' />
      </column>
      <column caption='% po sans accès basique' datatype='real' name='[Calculation_0750209690968065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[nb_pop_total] - [Calculation_1173245616844804] /100' />
      </column>
      <column caption='Pop sans acces basique' datatype='real' name='[Calculation_1173245616844804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[nb_pop_total] * (1 - [pct_acces_basique] / 100)' />
      </column>
      <column caption='Décès WASH (affichage négatif)' datatype='real' name='[Calculation_1173245616984069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-SUM([nb_deces_wash])' />
      </column>
      <column caption='Nombre de pays' datatype='integer' name='[Calculation_1173245617086470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([pays])' />
      </column>
      <column caption='Stabilité politique moyenne' datatype='real' name='[Calculation_1173245617160199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([stabilite_politique])' />
      </column>
      <column caption='Catégorie stabilité' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1173245617254408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [stabilite_politique] &gt;= [Parameters].[Paramètre 1]&#13;&#10;THEN &quot;Stable&quot;&#13;&#10;ELSE &quot;Instable&quot;&#13;&#10;END' />
      </column>
      <column caption='Niveau stabilité' datatype='string' name='[Calculation_1173245617340425]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [stabilite_politique] &gt;= 0.5 THEN &quot;Élevée&quot;&#13;&#10;ELSEIF [stabilite_politique] &gt;= 0 THEN &quot;Modérée&quot;&#13;&#10;ELSEIF [stabilite_politique] &gt;= -0.5 THEN &quot;Faible&quot;&#13;&#10;ELSE &quot;Critique&quot;&#13;&#10;END' />
      </column>
      <column caption='Pays sous seuil (booléen)' datatype='boolean' name='[Calculation_1173245617442826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[stabilite_politique] &lt; [Parameters].[Paramètre 1]' />
      </column>
      <column caption='Écart basique - safely managed' datatype='real' name='[Calculation_1173245617553419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[pct_acces_basique] - [pct_acces_securise]' />
      </column>
      <column caption='Safely managed disponible' datatype='boolean' name='[Calculation_1173245617664012]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([pct_acces_securise])' />
      </column>
      <column caption='Flag D1 — Création' datatype='boolean' name='[Calculation_1173245617754125]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[pct_acces_basique] &lt; 75&#13;&#10;AND [pct_pop_rurale] &gt; 50' />
      </column>
      <column caption='Flag D2 — Modernisation' datatype='boolean' name='[Calculation_1173245617840142]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[pct_acces_basique] &gt;= 75&#13;&#10;AND (ISNULL([pct_acces_securise])&#13;&#10;OR [pct_acces_securise] &lt; 50)' />
      </column>
      <column caption='Flag D3 — Consulting' datatype='boolean' name='[Calculation_1173245617958927]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[stabilite_politique] &gt; [Parameters].[Paramètre 1]' />
      </column>
      <column caption='Diagnostic DWFA' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1173245618044944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [pct_acces_basique] &lt; 75&#13;&#10;AND [pct_pop_rurale] &gt; 50&#13;&#10;THEN &quot;D1 — Création&quot;&#13;&#10;ELSEIF [pct_acces_basique] &gt;= 75&#13;&#10;AND (ISNULL([pct_acces_securise])&#13;&#10;OR [pct_acces_securise] &lt; 50)&#13;&#10;THEN &quot;D2 — Modernisation&quot;&#13;&#10;ELSEIF [stabilite_politique] &gt; [Parameters].[Paramètre 1]&#13;&#10;THEN &quot;D3 — Consulting&quot;&#13;&#10;ELSE &quot;Non classifié&quot;&#13;&#10;END' />
      </column>
      <column caption='[LOD] Part rurale mondiale' datatype='real' name='[Calculation_1173245618155537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [annee] :&#13;&#10;  SUM([nb_pop_rurale]) / SUM([nb_pop_total]) * 100 }' />
      </column>
      <column caption='[LOD] Population mondiale totale' datatype='real' name='[Calculation_1173245618257938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [annee] :&#13;&#10;  SUM([nb_pop_total]) }' />
      </column>
      <column caption='pop sans accès2' datatype='real' name='[Calculation_1173245641068563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nb_pop_total] * (1 - [pct_acces_basique] / 100)) / 1000000000' />
      </column>
