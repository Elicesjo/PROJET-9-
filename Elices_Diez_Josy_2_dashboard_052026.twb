            <column caption='Pct Acces Securise' datatype='real' name='[pct_acces_securise]' role='measure' type='quantitative' />
            <column aggregate-role-from='[pays]' caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column datatype='real' name='[stabilite_politique]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1173245617160199]' derivation='User' name='[usr:Calculation_1173245617160199:qk]' pivot='key' type='quantitative' />
