          <formatted-text>
            <run bold='true' fontsize='10'>Taux de mortalité </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dwfa_consolide' name='federated.1menff51pj1qnx16o8lmw0z352oz' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.1menff51pj1qnx16o8lmw0z352oz'>
            <column caption='% po sans accès basique' datatype='real' name='[Calculation_0750209690968065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[nb_pop_total] - [Calculation_1173245616844804] /100' />
