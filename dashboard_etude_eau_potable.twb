    <worksheet name='KPI Population sans accès'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='10'>Population sans accès </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dwfa_consolide' name='federated.1menff51pj1qnx16o8lmw0z352oz' />
          </datasources>
          <datasource-dependencies datasource='federated.1menff51pj1qnx16o8lmw0z352oz'>
            <column caption='Pop sans acces basique' datatype='real' name='[Calculation_1173245616844804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[nb_pop_total] * (1 - [pct_acces_basique] / 100)' />
