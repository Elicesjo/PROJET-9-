            <datasource caption='Paramètres' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Stabilité Politique (seuil -3 à 3)' datatype='real' name='[Paramètre 1]' param-domain-type='range' role='measure' type='quantitative' value='-0.89999999999999991'>
              <calculation class='tableau' formula='-0.89999999999999991' />
              <range granularity='0.1' max='3.0' min='-3.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1menff51pj1qnx16o8lmw0z352oz'>
            <column caption='seuil stab' datatype='boolean' name='[Calculation_0297146322272256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([stabilite_politique], 0) &gt;= [Parameters].[Paramètre 1]' />
            </column>
            <column caption='Pop sans acces basique' datatype='real' name='[Calculation_1173245616844804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[nb_pop_total] * (1 - [pct_acces_basique] / 100)' />
            </column>
            <column caption='Stabilité politique moyenne' datatype='real' name='[Calculation_1173245617160199]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([stabilite_politique])' />
            </column>
            <column caption='Annee' datatype='integer' name='[annee]' role='dimension' type='quantitative' />
