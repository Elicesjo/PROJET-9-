            <column aggregate-role-from='[pays]' caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column datatype='real' name='[stabilite_politique]' role='measure' type='quantitative' />
            <column-instance column='[nb_deces_wash]' derivation='Sum' name='[sum:nb_deces_wash:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1173245617160199]' derivation='User' name='[usr:Calculation_1173245617160199:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1menff51pj1qnx16o8lmw0z352oz].[Action (Priorité intervention,Pays)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action7_67B8D767EF9D4776BD5B1CFB0C0F3A5A]' user:ui-enumeration='all' user:ui-marker='enumerate'>
