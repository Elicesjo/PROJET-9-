        <aliases>
          <alias key='&quot;[federated.1menff51pj1qnx16o8lmw0z352oz].[avg:pct_acces_basique:qk]&quot;' value='% Acces Basique' />
          <alias key='&quot;[federated.1menff51pj1qnx16o8lmw0z352oz].[avg:pct_acces_securise:qk]&quot;' value='% Accès Sécurisé' />
          <alias key='&quot;[federated.1menff51pj1qnx16o8lmw0z352oz].[avg:pct_pop_rurale:qk]&quot;' value='% Pop Rurale' />
          <alias key='&quot;[federated.1menff51pj1qnx16o8lmw0z352oz].[avg:taux_mortalite_wash:qk]&quot;' value='Taux Mortalité (PCM)' />
          <alias key='&quot;[federated.1menff51pj1qnx16o8lmw0z352oz].[sum:Calculation_1173245616844804:qk]&quot;' value='Pop sans accès ' />
          <alias key='&quot;[federated.1menff51pj1qnx16o8lmw0z352oz].[sum:nb_deces_wash:qk]&quot;' value='Nb Décès ' />
          <alias key='&quot;[federated.1menff51pj1qnx16o8lmw0z352oz].[sum:nb_pop_total:qk]&quot;' value='Population Totale ' />
